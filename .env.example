# ============================ 智枢星 · 本地密钥配置模板 ============================
# 用法：复制为工作区根目录的 .env 后按需填写（.env 已被 .gitignore 排除，切勿提交）。
#   cp .env.example .env
# 格式：仅支持 KEY=VALUE 与整行 # 注释两种行（零第三方依赖，不用 python-dotenv）。
#   · 值不要加引号、不要写行内 # 注释（解析器会把它们当成值的一部分）
#   · 服务启动时：已存在于系统环境变量中的同名项不会被 .env 覆盖（系统环境变量优先）
#   · 例外：在控制台「设置」视图里保存过的那一项会以 .env 为准强制刷新，
#     因此若某密钥只存在于 shell/systemd 环境、不在 .env 里，请勿在设置页把它「清空」
#     （清空会写入 KEY= 并立即生效，等效于抹掉该进程内的这把密钥）
#   · 改完 .env 后：控制台「设置」视图保存会即时热重载；手工编辑则重启服务生效
#
# 【全部留空会怎样】系统仍可完整离线演示，不会报错、不会白屏：
#   LLM 对话     → Mock 确定性模板（规则解析需求档案 + 本地模板回答）
#   地图底图     → Canvas 离线折线示意
#   路线规划     → 内置枢纽引擎（偏好感知 A* + MADDPG 引导仿真）
# 缺哪一项、当前正在降级成什么，随时用 `zhishuxing doctor` 查看（输出不含密钥明文）。
# 也可以在控制台「设置」视图 / 移动端 PWA「系统设置 → 服务与密钥」里直接填写并保存。
# ==================================================================================


# ---------------------------------------------------------------- 高德开放平台
# 申请入口：https://lbs.amap.com/ → 右上角「控制台」→「应用管理」→「我的应用」
#           （直达 https://console.amap.com/dev/key/app）→ 创建新应用 → 在该应用下「添加 Key」
# 一个 Key 只能选一种「服务平台」，所以下面两项要分别加两个 Key，不要用同一个充数。
# 额度提醒：个人开发者每日免费配额有限，规划一次行程会调用 2 次地理编码 + 1 次公交换乘。

# 高德 Web 服务 Key —— 后端用（地理编码 + 公交换乘规划）
# 添加 Key 时「服务平台」必须选：Web服务
# 留空 → /api/plan 的 engine=amap 返回 400 并说明原因，/api/chat 市际 OD 给出话术提示，
#         自动改用内置枢纽引擎，演示不中断。
AMAP_REST_KEY=

# 高德 Web端(JS API) Key —— 前端用（路线规划页的真实地图底图）
# 添加 Key 时「服务平台」必须选：Web端(JS API)
# 留空 → 回退 Canvas 离线折线示意图（标注「未配置 AMAP_JS_KEY」）；
#         若留空但已填 AMAP_REST_KEY，会尝试复用它，但平台类型不同通常会导致底图鉴权失败。
AMAP_JS_KEY=

# 高德 JS API 安全密钥 —— 与上面的 JS Key 配对，必须一起填
# 位置：JS Key 所在应用详情页的「安全密钥」/「SecurityJsCode」字段（与 JS Key 成对下发）
# 为什么必填：2021-12-02 之后申请的 JS Key 强制配安全密钥，缺了它 AMap 全局对象初始化不出来，
#             前端表现为「高德地图初始化失败」并回退 Canvas —— 只填 JS Key 等于没填。
# 留空 → 同上，回退 Canvas 折线。
AMAP_SECURITY_CODE=


# ---------------------------------------------------------------- LLM（SiliconFlow / 任意 OpenAI 兼容服务）
# 申请入口：https://cloud.siliconflow.cn/ → 登录 → 左侧「账号」→ API 密钥 → 新建密钥
# 用于：对话合成 / 需求档案解析 / 起终点(OD) 提取。
# 留空 → 走 MockLLMAdapter（确定性模板），规则关键词解析仍然生效，全链路可离线演示；
#         「设置真实适配器」会在响应里如实标注 real_adapter_error，不会静默失败。
SILICONFLOW_API_KEY=

# 可选：OpenAI 兼容端点。默认 https://api.siliconflow.cn/v1
# 换成自建/其他兼容服务（如 vLLM、Ollama 的 OpenAI 兼容口）时改这里，注意以 /v1 结尾。
SILICONFLOW_BASE_URL=

# 可选：默认模型 ID。默认 deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# 需在服务商侧有该模型的调用权限；控制台对话面板里填的模型 ID 优先级更高。
SILICONFLOW_MODEL=

# 可选：需要安装 openai 包才能走真实适配器（pip install .[llm]）。
# 未安装时即使填了 Key 也会自动降级为 Mock，并在响应中注明原因。


# ---------------------------------------------------------------- 其他可选项

# 可选：高德请求超时秒数（默认 10）。网络较差可适当调大。
AMAP_TIMEOUT=
